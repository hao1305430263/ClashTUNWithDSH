{
  "name": "clash-tun-with-dsh",
  "version": "1.0.0",
  "description": "Lift web_fetch's non-public IP guard so DSH works behind Clash TUN (fake-ip).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "clash",
    "clash-verge",
    "tun",
    "fake-ip",
    "web-fetch",
    "ssrf"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "ClashTUNWithDSH authors",
  "homepage": "https://github.com/ffdnm/ClashTUNWithDSH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffdnm/ClashTUNWithDSH.git"
  },
  "bugs": {
    "url": "https://github.com/ffdnm/ClashTUNWithDSH/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README_CN.md",
    "LICENSE",
    "market.json",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test",
    "market": "node scripts/make-market-index.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0 <1.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
